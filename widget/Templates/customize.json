{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "表示するカメラ",
      "weight": "bolder"
    },
    {
      "type": "Input.ChoiceSet",
      "id": "cameraId",
      "style": "compact",
      "value": "${selected}",
      "choices": [
        {
          "$data": "${choices}",
          "title": "${title}",
          "value": "${value}"
        }
      ]
    },
    {
      "type": "TextBlock",
      "$when": "${note != ''}",
      "text": "${note}",
      "size": "small",
      "color": "attention",
      "wrap": true
    }
  ],
  "actions": [
    { "type": "Action.Execute", "verb": "save", "title": "保存" },
    { "type": "Action.Execute", "verb": "cancel", "title": "キャンセル" }
  ]
}
