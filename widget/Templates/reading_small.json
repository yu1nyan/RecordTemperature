{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "${name}",
      "size": "small",
      "isSubtle": true,
      "wrap": false
    },
    {
      "type": "TextBlock",
      "text": "${temp}",
      "size": "extraLarge",
      "weight": "bolder",
      "spacing": "small"
    },
    {
      "type": "TextBlock",
      "text": "湿度 ${hum}",
      "spacing": "none"
    },
    {
      "type": "TextBlock",
      "text": "${fluShort}",
      "color": "${fluColor}",
      "weight": "bolder",
      "size": "small",
      "spacing": "small",
      "wrap": true
    }
  ]
}
